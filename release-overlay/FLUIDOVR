// Initial appearance-first fluid bindings for the classic Duke material
// families. Mounted mods may replace these rule IDs or add map-local rules.
FLUIDOVR
{
	// scale is the world-unit domain divisor; base wavelength is
	// approximately 2*pi*scale/frequency. amplitude and virtualheight are
	// world-unit half-heights. All shipped values are explicit so this file is
	// the appearance authority and can be tuned without rebuilding the engine.
	profile "water.waves"
	{
		style waves
		bodycolor 0.025 0.11 0.16
		undersidecolor 0.018 0.065 0.09
		crestcolor 0.18 0.28 0.32
		emissioncolor 0 0 0
		emission 0
		roughness 0.08
		undersideroughness 0.16
		opacity 0.94
		scale 64
		amplitude 4
		frequency 2
		timescale 1
		speed 0.5
		flow 1 0
		anisotropy 1
		warp 0.2
		choppiness 0.48
		normalstrength 1.1
		virtualheight 4
		seed 13
		octaves 4
	}

