// Initial appearance-first fluid bindings for the classic Duke material
// families. Mounted mods may replace these rule IDs or add map-local rules.
FLUIDOVR
{
	// scale is the world-unit domain divisor; base wavelength is
	// approximately 2*pi*scale/frequency. amplitude is the normalized aggregate
	// shading-field height and virtualheight is the optional parallax half-height,
	// both in world units. All values are explicit for overlay-only tuning.
	profile "water.waves"
	{
		style waves
		bodycolor 0.025 0.11 0.16
		undersidecolor 0.018 0.065 0.09
		crestcolor 0.18 0.28 0.32
		emissioncolor 0 0 0
		emission 0
		roughness 0.1
		undersideroughness 0.16
		opacity 0.94
		scale 64
		amplitude 8
		frequency 2
		lacunarity 1.9
		gain 0.28
		timescale 4
		speed 0.5
		flow 1 0
		anisotropy 1
		warp 1.05
		choppiness 3.6
		octaverotation 37
		choppyrelaxation 0.2
		noisescale 0.65
		maxslope 1.25
		crestgain 0.32
		foamcolor 0.82 0.9 0.95
		foamamount 0.72
		foamroughness 0.88
		foamthreshold 0.62
		foamsoftness 0.12
		foambreakupscale 2.4
