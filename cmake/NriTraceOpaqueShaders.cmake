set(NRI_TRACE_OPAQUE_FAMILIES TraceOpaque TraceOpaqueLeanDebug TraceOpaqueCache TraceOpaqueTyped TraceOpaqueTypedCache)

# Page variants use a second pair of geometry streams. Ordinary scenes keep
# the original traversal and resource layout for every shading configuration.
function(raze_add_trace_opaque_shaders outputs directory profile)
	set(families ${NRI_TRACE_OPAQUE_FAMILIES})
	set(shader_args ${RAZE_NRI_COMMON_SHADER_ARGS})
	if(NOT profile STREQUAL "PRODUCTION")
		list(REMOVE_ITEM shader_args -DNRI_SHADER_DIAGNOSTICS=0)
		list(APPEND shader_args -DNRI_SHADER_DIAGNOSTICS=1)
	endif()
	if(profile STREQUAL "DIAGNOSTIC")
		list(APPEND families TraceOpaqueCompare TraceOpaqueCompareCache)
	elseif(profile STREQUAL "PERF_AUDIT")
		list(APPEND shader_args -DNRI_SHADER_PERF_AUDIT_ONLY=1)
	endif()

	set(source "${CMAKE_CURRENT_SOURCE_DIR}/common/rendering/nri/shaders/TraceOpaque.cs.hlsl")
	set(blobs "")
	foreach(family IN LISTS families)
		set(defines "")
		if(family MATCHES "LeanDebug")
			list(APPEND defines -DNRI_TRACE_GEOMETRY_DEBUG_ONLY=1)
		endif()
		if(family MATCHES "Typed")
			list(APPEND defines -DNRI_SPATIAL_ABSENCE_FORMAT=1)
		elseif(family MATCHES "Compare")
			list(APPEND defines -DNRI_SPATIAL_ABSENCE_FORMAT=2)
		endif()
		if(family MATCHES "Cache")
			list(APPEND defines -DNRI_INDIRECT_RADIANCE_CACHE=1)
		endif()

		set(backends dxil)
		if(NOT profile STREQUAL "PERF_AUDIT" AND NOT family MATCHES "Compare")
			list(APPEND backends spirv)
		endif()
		foreach(backend IN LISTS backends)
			set(backend_args "")
			if(backend STREQUAL "spirv")
				list(APPEND backend_args -spirv -fspv-target-env=vulkan1.2 -fvk-use-dx-layout ${RAZE_NRI_RAY_QUERY_SPIRV_ARGS})
			elseif(profile STREQUAL "DIAGNOSTIC" AND NOT family MATCHES "Cache|Compare")
				list(APPEND backend_args -DNRI_FILTER_COMPARATOR=1)
			endif()
			foreach(geometry IN ITEMS Arena Page)
				set(stem "${family}")
				set(geometry_args "")
				if(geometry STREQUAL "Page")
					string(APPEND stem "Page")
					list(APPEND geometry_args -DNRI_ENABLE_PERSISTENT_VOXEL_PAGE=1)
				endif()
				set(blob "${directory}/${stem}.cs.${backend}")
				add_custom_command(OUTPUT "${blob}"
					COMMAND ${CMAKE_COMMAND} -E make_directory "${directory}"
					COMMAND "${RAZE_DXC_EXECUTABLE}" ${shader_args} ${backend_args} ${defines} ${geometry_args}
						-T cs_6_6 -E main -Fo "${blob}" "${source}"
					DEPENDS "${source}" ${NRI_SHARED_SHADER_FILES}
					JOB_POOL nri_trace_shaders
					VERBATIM)
				list(APPEND blobs "${blob}")
			endforeach()
		endforeach()
	endforeach()
	set(${outputs} "${blobs}" PARENT_SCOPE)
endfunction()
