cmake_minimum_required(VERSION 3.30)
foreach(_required SOURCE_ROOT RUNTIME_DIR)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/NriRuntimeManifest.cmake")
set(_receipt "${RUNTIME_DIR}/nri-runtime.json")
if(NOT EXISTS "${_receipt}")
    message(FATAL_ERROR "Missing NRI build provenance: ${_receipt}. Build the game with the vendored runtime first.")
endif()
file(READ "${_receipt}" _json)
foreach(_field schema mode configuration architecture sourceSha256 buildContextSha256 nriVersion agilityVersion)
    string(JSON _${_field} GET "${_json}" "${_field}")
endforeach()
if(NOT _schema EQUAL 1 OR NOT _mode STREQUAL "vendored-source")
    message(FATAL_ERROR "Unsupported NRI runtime provenance schema or mode")
endif()
if(NOT _configuration MATCHES "^(Debug|Release|RelWithDebInfo|MinSizeRel)$")
    message(FATAL_ERROR "Invalid NRI runtime configuration")
endif()
if(DEFINED EXPECTED_CONFIGURATION AND NOT _configuration STREQUAL EXPECTED_CONFIGURATION)
    message(FATAL_ERROR "NRI runtime configuration ${_configuration} does not match ${EXPECTED_CONFIGURATION}")
endif()
if(NOT _agilityVersion STREQUAL "619.0")
    message(FATAL_ERROR "NRI runtime requires the matching Agility SDK 619.0")
endif()
foreach(_field id version path)
    string(JSON _compiler_${_field} GET "${_json}" compiler "${_field}")
    if(_compiler_${_field} STREQUAL "")
        message(FATAL_ERROR "NRI compiler provenance is incomplete")
    endif()
endforeach()
nri_build_context("${_architecture}" "${_compiler_id}" "${_compiler_version}" "${_compiler_path}"
    "${_agilityVersion}" _current_context)
if(NOT _buildContextSha256 STREQUAL _current_context)
    message(FATAL_ERROR "NRI runtime build context does not match its recorded compiler/capabilities")
endif()
nri_source_fingerprint("${SOURCE_ROOT}" _current_hash _current_version)
if(NOT _sourceSha256 STREQUAL _current_hash OR NOT _nriVersion EQUAL _current_version)
    message(FATAL_ERROR "NRI runtime provenance is stale for the current vendored source/build recipe. Rebuild the game.")
endif()
nri_expected_runtime("${_architecture}" _expected_options _expected_paths)
list(LENGTH _expected_options _expected_option_count)
string(JSON _option_count LENGTH "${_json}" options)
if(NOT _option_count EQUAL _expected_option_count)
    message(FATAL_ERROR "NRI runtime option inventory is incomplete or unexpected")
endif()
foreach(_pair IN LISTS _expected_options)
    string(REPLACE "=" ";" _parts "${_pair}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _expected)
    string(JSON _value GET "${_json}" options "${_name}")
    if(NOT _value STREQUAL _expected)
        message(FATAL_ERROR "NRI runtime capability ${_name} must be ${_expected}")
    endif()
endforeach()
string(JSON _count LENGTH "${_json}" files)
list(LENGTH _expected_paths _expected_count)
if(NOT _count EQUAL _expected_count)
    message(FATAL_ERROR "NRI runtime file inventory is incomplete or unexpected")
endif()
set(_seen "")
math(EXPR _last "${_count} - 1")
foreach(_index RANGE 0 ${_last})
    string(JSON _path GET "${_json}" files ${_index} path)
    string(JSON _hash GET "${_json}" files ${_index} sha256)
    if(NOT _path IN_LIST _expected_paths OR _path IN_LIST _seen)
        message(FATAL_ERROR "Invalid or duplicate NRI runtime path: ${_path}")
    endif()
    list(APPEND _seen "${_path}")
    if(NOT EXISTS "${RUNTIME_DIR}/${_path}" OR IS_DIRECTORY "${RUNTIME_DIR}/${_path}")
        message(FATAL_ERROR "Required NRI runtime file is missing: ${_path}")
    endif()
    file(SHA256 "${RUNTIME_DIR}/${_path}" _actual)
    if(NOT _hash STREQUAL _actual)
        message(FATAL_ERROR "NRI runtime hash mismatch: ${_path}")
    endif()
endforeach()
nri_verify_binary_identity("${RUNTIME_DIR}/NRI.dll" "${_current_hash}" "${_configuration}" "${_current_context}")
message(STATUS "Verified vendored NRI runtime (${_configuration}, ${_architecture})")
