function(nri_json_string value result)
    string(REPLACE "\\" "\\\\" _value "${value}")
    string(REPLACE "\"" "\\\"" _value "${_value}")
    string(REPLACE "\n" "\\n" _value "${_value}")
    string(REPLACE "\r" "\\r" _value "${_value}")
    string(REPLACE "\t" "\\t" _value "${_value}")
    set(${result} "\"${_value}\"" PARENT_SCOPE)
endfunction()

function(nri_source_fingerprint root result version)
    # CMake configurations use forward slashes; PowerShell packaging commonly
    # supplies backslashes. Normalize before sorting absolute input paths.
    file(TO_CMAKE_PATH "${root}" root)
    set(_vendor "${root}/libraries/NRIFramework/External/NRI")
    set(_patterns
        "${_vendor}/Include/*" "${_vendor}/Source/*" "${_vendor}/Resources/*" "${_vendor}/Shaders/*"
        "${root}/libraries/ShaderMake/ShaderMake/*")
    if(CMAKE_SCRIPT_MODE_FILE)
        file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE ${_patterns})
    else()
        file(GLOB_RECURSE _files CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE ${_patterns})
    endif()
    list(APPEND _files "${_vendor}/CMakeLists.txt" "${root}/libraries/ShaderMake/CMakeLists.txt"
        "${root}/cmake/RazeNriRuntime.cmake" "${root}/cmake/nri-runtime/CMakeLists.txt"
        "${root}/cmake/NriRuntimeManifest.cmake" "${root}/cmake/StageNriRuntime.cmake"
        "${root}/cmake/VerifyNriRuntime.cmake")
    list(SORT _files)
    set(_identity "")
    foreach(_file IN LISTS _files)
        if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
            message(FATAL_ERROR "NRI provenance input is missing: ${_file}")
        endif()
        file(RELATIVE_PATH _relative "${root}" "${_file}")
        file(SHA256 "${_file}" _hash)
        string(APPEND _identity "${_relative}:${_hash}\n")
    endforeach()
    string(SHA256 _fingerprint "${_identity}")
    file(READ "${_vendor}/Include/NRI.h" _header)
    string(REGEX MATCH "NRI_VERSION ([0-9]+)" _match "${_header}")
    if(NOT CMAKE_MATCH_1)
        message(FATAL_ERROR "Cannot identify vendored NRI version")
    endif()
    set(${version} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(${result} "${_fingerprint}" PARENT_SCOPE)
    set(${result}_FILES "${_files}" PARENT_SCOPE)
endfunction()

function(nri_build_context architecture compiler_id compiler_version compiler_path agility result)
    nri_expected_runtime("${architecture}" _options _paths)
    string(SHA256 _hash "${architecture}\n${compiler_id}\n${compiler_version}\n${compiler_path}\n${agility}\n${_options}\n")
    set(${result} "${_hash}" PARENT_SCOPE)
endfunction()

function(nri_verify_binary_identity path source_hash configuration context_hash)
    set(_marker "DukeRTNriBuildIdentity:${source_hash}:${configuration}:${context_hash}")
    string(HEX "${_marker}" _marker_hex)
    file(READ "${path}" _binary HEX)
    string(FIND "${_binary}" "${_marker_hex}" _position)
    if(_position LESS 0)
        message(FATAL_ERROR "NRI DLL was not compiled for the recorded source/build identity: ${path}")
    endif()
endfunction()

function(nri_expected_runtime architecture options paths)
    if(NOT architecture MATCHES "^(x64|arm64)$")
        message(FATAL_ERROR "Unsupported NRI runtime architecture: ${architecture}")
    endif()
    set(_on D3D11_SUPPORT D3D12_SUPPORT VK_SUPPORT NONE_SUPPORT VALIDATION_SUPPORT
        DEBUG_NAMES_AND_ANNOTATIONS NVTX_SUPPORT AGILITY_SDK_SUPPORT NIS_SDK)
    set(_options "")
    foreach(_name IN LISTS _on)
        list(APPEND _options "NRI_ENABLE_${_name}=ON")
    endforeach()
    if(architecture STREQUAL "x64")
        set(_sdk ON)
    else()
        set(_sdk OFF)
    endif()
    foreach(_name NGX_SDK FFX_SDK XESS_SDK AMDAGS NVAPI)
        list(APPEND _options "NRI_ENABLE_${_name}=${_sdk}")
    endforeach()
    list(APPEND _options NRI_STREAMER_THREAD_SAFE=ON NRI_STATIC_LIBRARY=OFF NRI_ENABLE_IMGUI_EXTENSION=OFF)
    set(_paths NRI.dll NRI-LICENSE.txt AgilitySDK/D3D12Core.dll AgilitySDK/d3d12SDKLayers.dll)
    if(architecture STREQUAL "x64")
        list(APPEND _paths amd_ags_x64.dll amd_fidelityfx_dx12.dll amd_fidelityfx_vk.dll
            FidelityFX-SDK-LICENSE.txt libxess.dll nvngx_dlss.dll nvngx_dlssd.dll)
    endif()
    list(SORT _paths)
    set(${options} "${_options}" PARENT_SCOPE)
    set(${paths} "${_paths}" PARENT_SCOPE)
endfunction()
