cmake_minimum_required(VERSION 3.30)
foreach(_required SOURCE_ROOT BUILD_INPUTS RUNTIME_DIR)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/NriRuntimeManifest.cmake")
include("${BUILD_INPUTS}")
file(TO_CMAKE_PATH "${SOURCE_ROOT}" SOURCE_ROOT)
file(TO_CMAKE_PATH "${NRI_INPUT_SOURCE_ROOT}" NRI_INPUT_SOURCE_ROOT)
if(NOT NRI_INPUT_SOURCE_ROOT STREQUAL SOURCE_ROOT)
    message(FATAL_ERROR "NRI runtime input belongs to a different source checkout")
endif()
nri_expected_runtime("${NRI_INPUT_ARCHITECTURE}" _expected_options _expected_paths)
list(SORT NRI_INPUT_PATHS)
if(NOT NRI_INPUT_PATHS STREQUAL _expected_paths)
    message(FATAL_ERROR "NRI runtime input inventory does not match the required capability set")
endif()
set(_options "")
foreach(_pair IN LISTS _expected_options)
    string(REPLACE "=" ";" _parts "${_pair}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _expected)
    if(NOT "${${_name}}" STREQUAL "${_expected}")
        message(FATAL_ERROR "NRI runtime build option ${_name} must be ${_expected}")
    endif()
    string(APPEND _options "    \"${_name}\": \"${_expected}\",\n")
endforeach()
string(REGEX REPLACE ",\n$" "\n" _options "${_options}")
nri_source_fingerprint("${SOURCE_ROOT}" _source_hash _version)
nri_build_context("${NRI_INPUT_ARCHITECTURE}" "${NRI_INPUT_COMPILER_ID}" "${NRI_INPUT_COMPILER_VERSION}"
    "${NRI_INPUT_COMPILER_PATH}" "${NRI_INPUT_AGILITY_VERSION}" _context_hash)
if(NOT NRI_INPUT_SOURCE_SHA256 STREQUAL _source_hash OR NOT NRI_INPUT_CONTEXT_SHA256 STREQUAL _context_hash)
    message(FATAL_ERROR "NRI build inputs do not match the current source/build identity; rebuild the runtime.")
endif()
nri_verify_binary_identity("${NRI_INPUT_FILE_NRI_dll}" "${_source_hash}" "${NRI_INPUT_CONFIGURATION}" "${_context_hash}")
set(_files "")
foreach(_path IN LISTS _expected_paths)
    string(MAKE_C_IDENTIFIER "${_path}" _key)
    set(_source "${NRI_INPUT_FILE_${_key}}")
    if(NOT EXISTS "${_source}" OR IS_DIRECTORY "${_source}")
        message(FATAL_ERROR "Required source-built NRI runtime file is missing: ${_source}")
    endif()
    get_filename_component(_directory "${RUNTIME_DIR}/${_path}" DIRECTORY)
    file(MAKE_DIRECTORY "${_directory}")
    file(COPY_FILE "${_source}" "${RUNTIME_DIR}/${_path}" ONLY_IF_DIFFERENT)
    file(SHA256 "${RUNTIME_DIR}/${_path}" _hash)
    string(APPEND _files "    {\"path\": \"${_path}\", \"sha256\": \"${_hash}\"},\n")
endforeach()
string(REGEX REPLACE ",\n$" "\n" _files "${_files}")
foreach(_field CONFIGURATION ARCHITECTURE COMPILER_ID COMPILER_VERSION COMPILER_PATH AGILITY_VERSION)
    nri_json_string("${NRI_INPUT_${_field}}" _${_field})
endforeach()
set(_manifest "{\n  \"schema\": 1,\n  \"mode\": \"vendored-source\",\n  \"configuration\": ${_CONFIGURATION},\n  \"architecture\": ${_ARCHITECTURE},\n  \"sourceSha256\": \"${_source_hash}\",\n  \"buildContextSha256\": \"${_context_hash}\",\n  \"nriVersion\": ${_version},\n  \"agilityVersion\": ${_AGILITY_VERSION},\n  \"compiler\": {\"id\": ${_COMPILER_ID}, \"version\": ${_COMPILER_VERSION}, \"path\": ${_COMPILER_PATH}},\n  \"options\": {\n${_options}  },\n  \"files\": [\n${_files}  ]\n}\n")
set(_receipt "${RUNTIME_DIR}/nri-runtime.json")
if(EXISTS "${_receipt}")
    file(READ "${_receipt}" _existing)
else()
    set(_existing "")
endif()
if(NOT _existing STREQUAL _manifest)
    file(WRITE "${_receipt}" "${_manifest}")
endif()
set(EXPECTED_CONFIGURATION "${NRI_INPUT_CONFIGURATION}")
include("${CMAKE_CURRENT_LIST_DIR}/VerifyNriRuntime.cmake")
